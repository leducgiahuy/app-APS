..new Set(employees.map(e => e.team).filter(Boolean))];\n53: \n54:   // Lọc danh sách nhân sự\n55:   const filteredEmployees = employees.filter(emp => {\n56:     const matchesSearch =\n57:       emp.name.toLowerCase().includes(searchTerm.toLowerCase()) ||\n58:       emp.title.toLowerCase().includes(searchTerm.toLowerCase()) ||\n59:       emp.code.toLowerCase().includes(searchTerm.toLowerCase());\n60:     const matchesTeam = selectedTeam === 'ALL' || emp.team === selectedTeam;\n61:     return matchesSearch && matchesTeam;\n62:   });\n63: \n64:   const handleSubmit = async (e) => {\n65:     e.preventDefault();\n66:     if (!formData.name || !formData.title) return;\n67:     const success = await addEmployee(formData);\n68:     if (success) {\n69:       setFormData({\n70:         name: '',\n71:         title: '',\n72:         team: 'Ban Quản Lý',\n73:         phone: '',\n74:         email: '',\n75:         standardHours: 8\n76:       });\n77:       setShowAddModal(false);\n78:     }\n79:   };\n80: \n81:   return (\n82:     <div className=\"space-y-6\">\n83:       \n84:       {/* 4 Thẻ KPI Tóm Tắt Đầu Trang */}\n85:       <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n86:         \n87:         {/* KPI 1: Tổng nhân sự */}\n88:         <div className=\"p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex items-center justify-between\">\n89:           <div>\n90:             <p className=\"text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400\">\n91:               Tổng Nhân Sự\n92:             </p>\n93:             <p className=\"text-2xl font-black text-slate-900 dark:text-white mt-1\">\n94:               {totalEmployees} <span className=\"text-sm font-normal text-slate-500\">người</span>\n95:             </p>\n96:           </div>\n97:           <div className=\"w-12 h-12 rounded-xl bg-sky-500/10 text-sky-500 flex items-center justify-center\">\n98:             <Users