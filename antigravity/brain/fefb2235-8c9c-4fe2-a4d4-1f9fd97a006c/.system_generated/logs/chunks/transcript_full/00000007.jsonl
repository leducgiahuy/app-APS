 undefined) gantt.speed = task.speedStatus;\n186:   }\n187: \n188:   writeDb(db);\n189: \n190:   return res.json({\n191:     success: true,\n192:     message: 'Cập nhật nhiệm vụ thành công và đã đồng bộ',\n193:     data: task\n194:   });\n195: }\n196: \n197: // Xóa nhiệm vụ (đồng bộ xóa trong Gantt)\n198: export function deleteTask(req, res) {\n199:   const db = readDb();\n200:   const { id } = req.params;\n201: \n202:   const index = db.tasks.findIndex(t => t.id === id);\n203:   if (index === -1) {\n204:     return res.status(404).json({ success: false, message: 'Không tìm thấy nhiệm vụ' });\n205:   }\n206: \n207:   const removed = db.tasks.splice(index, 1);\n208: \n209:   // Đồng bộ xóa trong ganttItems\n210:   if (db.ganttItems) {\n211:     db.ganttItems = db.ganttItems.filter(g => g.id !== removed[0].ganttId && g.title !== removed[0].title);\n212:   }\n213: \n214:   writeDb(db);\n215: \n216:   return res.json({\n217:     success: true,\n218:     message: 'Đã xóa nhiệm vụ và đồng bộ gỡ khỏi biểu đồ Gantt',\n219:     data: removed[0]\n220:   });\n221: }\n222: \n223: // Đăng ký ca làm việc tăng ca (Overtime / OT)\n224: export function createOvertime(req, res) {\n225:   const db = readDb();\n226:   const { taskId, employeeId, hours, date, reason } = req.body;\n227: \n228:   if (!employeeId || !hours) {\n229:     return res.status(400).json({ success: false, message: 'Vui lòng chọn nhân viên và số giờ tăng ca' });\n230:   }\n231: \n232:   const emp = db.employees.find(e => e.id === employeeId);\n233:   const task = taskId ? db.tasks.find(t => t.id === taskId) : null;\n234: \n235:   const newOt = {\n236:     id: `ot-${Date.now()}`,\n237:     taskId: taskId || 'general',\n238:     taskTitle: task ? task.title : 'Tăng ca đột xuất tại công trường',\n239:     employeeId,\n240:     employeeName: emp ? emp.name : 'Chưa xác định',\n241:     hours: Number(hours),\n242:     date: date || new Date().toISOString().split('T')[0],\n243:     reason: reason || 'Hoàn thành công việc khẩn cấp',\n244:     approvedBy: 'Trần Quốc Hưng (Chỉ huy trưởng)',\n245:     status: 'approved'\n246:   };\n247: \n248:   db.overtimes.push(newOt);\n249: \n250:   // Đồng bộ sang Gantt item tương ứng để hiện tag [+x h OT]\n251:   if (taskId || task) {\n252:     const gantt = (db.ganttItems || []).find(g => g.id === task?.ganttId || g.title === (task ? task.title : ''));\n253:     if (gantt) {\n254:       gantt.overtimeHours = (gantt.overtimeHours || 0) + Number(hours);\n255:     }\n256:   }\n257: \n258:   writeDb(db);\n259: \n260:   return res.status(201).json({\n261:     success: true,\n262:     message: `Đã đăng ký ${hours}h tăng ca cho ${newOt.employeeName}`,\n263:     data: newOt\n264:   });\n265: }\n266: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
