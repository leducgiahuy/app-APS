e header in the right column's DOM.\n\n\n","tool_calls":[{"name":"view_file","args":{"AbsolutePath":"C:\\Users\\GiaWyy\\.gemini\\antigravity\\scratch\\aps-project-manager\\frontend\\src\\context\\AppContext.jsx","EndLine":150,"StartLine":1,"toolAction":"Viewing AppContext.jsx","toolSummary":"View AppContext state and handlers"}}]}
{"step_index":236,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T03:49:00Z","content":"Created At: 2026-09-28T10:49:00+07:00\nCompleted At: 2026-09-28T10:49:01+07:00\nFile Path: `file:///C:/Users/GiaWyy/.gemini/antigravity/scratch/aps-project-manager/frontend/src/context/AppContext.jsx`\nTotal Lines: 323\nTotal Bytes: 9400\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React, { createContext, useContext, useState, useEffect } from 'react';\n2: import { api } from '../api';\n3: \n4: const AppContext = createContext();\n5: \n6: export function AppProvider({ children }) {\n7:   // Theme Light/Dark Mode\n8:   const [theme, setTheme] = useState(() => {\n9:     return localStorage.getItem('aps_theme') || 'dark';\n10:   });\n11: \n12:   // Tab điều hướng chính\n13:   const [activeTab, setActiveTab] = useState('hr'); // 'hr', 'tasks', 'gantt', 'dashboard'\n14: \n15:   // Thời gian thực (Real-time Clock chạy từng giây)\n16:   const [currentTime, setCurrentTime] = useState(new Date());\n17: \n18:   // Ngày được chọn trên thanh điều hướng ngày\n19:   const [selectedDate, setSelectedDate] = useState(new Date());\n20: \n21:   // Trạng thái thu gọn Sidebar\n22:   const [sidebarCollapsed, setSidebarCollapsed] = useState(false);\n23:   const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n24: \n25:   // Dữ liệu ứng dụng\n26:   const [employees, setEmployees] = useState([]);\n27:   const [tasks, setTasks] = useState([]);\n28:   const [overtimes, setOvertimes] = useState([]);\n29:   const [ganttItems, setGanttItems] = useState([]);\n30:   const [projects, setProjects] = useState([]);\n31:   const [stats, setStats] = useState(null);\n32:   const [loading, setLoading] = useState(true);\n33: \n34:   // Thông báo Toast\n35:   const [toast, setToast] = useState(null);\n36: \n37:   // Hiển thị thông báo nhanh\n38:   const showToast = (message, type = 'success') => {\n39:     setToast({ message, type });\n40:     setTimeout(() => setToast(null), 3500);\n41:   };\n42: \n43:   // Cập nhật Dark Mode trên HTML root element\n44:   useEffect(() => {\n45:     if (theme === 'dark') {\n46:       document.documentElement.classList.add('dark');\n47:     } else {\n48:       document.documentElement.classList.remove('dark');\n49:     }\n50:     localStorage.setItem('aps_theme', theme);\n51:   }, [theme]);\n52: \n53:   const toggleTheme = () => {\n54:     setTheme(prev => (prev === 'dark' ? 'light' : 'dark'));\n55:   };\n56: \n57:   // Đồng hồ chạy thời gian thực mỗi 1 giây\n58:   useEffect(() => {\n59:     const timer = setInterval(() => {\n60:       setCurrentTime(new Date());\n61:     }, 1000);\n62:     return () => clearInterval(timer);\n63:   }, []);\n64: \n65:   // Điều hướng ngày: Hôm trước, Hôm nay, Hôm sau\n66:   const goToPrevDay = () => {\n67:     setSelectedDate(prev => {\n68:       const d = new Date(prev);\n69:       d.setDate(d.getDate() - 1);\n70:       return d;\n71:     });\n72:   };\n73: \n74:   const goToNextDay = () => {\n75:     setSelectedDate(prev => {\n76:       const d = new Date(prev);\n77:       d.setDate(d.getDate() + 1);\n78:       return d;\n79:     });\n80:   };\n81: \n82:   const goToToday = () => {\n83:     setSelectedDate(new Date());\n84:   };\n85: \n86:   // Tải toàn bộ dữ liệu từ Backend\n87:   const refreshAllData = async () => {\n88:     try {\n89:       setLoading(true);\n90:       const [empRes, taskRes, projRes, ganttRes, statRes] = await Promise.all([\n91:         api.getEmployees(),\n92:         api.getTasks(),\n93:         api.getProjects(),\n94:         api.getGanttItems(),\n95:         api.getStats()\n96:       ]);\n97: \n98:       if (empRes?.data) setEmployees(empRes.data);\n99:       if (taskRes?.data) {\n100:         setTasks(taskRes.data.tasks || []);\n101:         setOvertimes(taskRes.data.overtimes || []);\n102:       }\n103:       if (projRes?.data) setProjects(projRes.data);\n104:       if (ganttRes?.data) setGanttItems(ganttRes.data);\n105:       if (statRes?.data) setStats(statRes.data);\n106:     } catch (err) {\n107:       console.error('Lỗi khi tải dữ liệu từ backend:', err);\n108:       showToast('Đang chạy ở chế độ cục bộ hoặc chưa kết nối backend', 'info');\n109:     } finally {\n110:       setLoading(false);\n111:     }\n112:   };\n113: \n114:   useEffect(() => {\n115:     refreshAllData();\n116:   }, []);\n117: \n118:   // Hành động: Chuyển trạng thái điểm danh nhân sự (On-site / Vắng mặt)\n119:   const toggleOnSite = async (id) => {\n120:     try {\n121:       const res = await api.toggleOnSite(id);\n122:       showToast(res.message || 'Cập nhật trạng thái thành công');\n123:       // Cập nhật state trực tiếp\n124:       setEmployees(prev => prev.map(emp => {\n125:         if (emp.id === id) {\n126:           const newStatus = !emp.isOnSite;\n127:           return {\n128:             ...emp,\n129:             isOnSite: newStatus,\n130:             checkInTime: newStatus ? new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : null\n131:           };\n132:         }\n133:         return emp;\n134:       }));\n135:     } catch (err) {\n136:       showToast('Lỗi khi cập nhật trạng thái', 'error');\n137:     }\n138:   };\n139: \n140:   // Hành động: Thêm nhân sự mới\n141:   const addEmployee = async (employeeData) => {\n142:     try {\n143:       const res = await api.createEmployee(employeeData);\n144:       showToast('Thêm nhân sự mới thành công');\n145:       refreshAllData();\n146:       return true;\n147:     } catch (err) {\n148:       showToast(err.message || 'Lỗi khi thêm nhân sự', 'error');\n149:       return false;\n150:     }\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
