                            className=\"w-2.5 h-2.5 rounded-full flex-shrink-0\"\n443:                             style={{ backgroundColor: item.color }}\n444:                           />\n445:                         )}\n446:                         <span className=\"truncate\" title={item.title}>\n447:                           {item.title}\n448:                         </span>\n449:                       </div>\n450: \n451:                       {/* Cột ĐV (Đơn vị thực hiện: TK, PL, CDT, NT, VN) */}\n452:                       <div className=\"w-14 text-center py-1 px-1 font-mono font-bold text-[11px] border-r border-slate-100 dark:border-slate-800 text-sky-600 dark:text-sky-400\">\n453:                         {item.unit}\n454:                       </div>\n455: \n456:                       {/* Cột Bắt Đầu */}\n457:                       <div className=\"w-20 text-center py-1 px-1 text-[11px] border-r border-slate-100 dark:border-slate-800 text-slate-500\">\n458:                         {item.startDate.slice(5).replace('-', '/')}\n459:                       </div>\n460: \n461:                       {/* Cột Kết Thúc */}\n462:                       <div className=\"w-20 text-center py-1 px-1 text-[11px] border-r border-slate-100 dark:border-slate-800 text-slate-500\">\n463:                         {item.endDate.slice(5).replace('-', '/')}\n464:                       </div>\n465: \n466:                       {/* Cột Ngày (Duration) */}\n467:                       <div className=\"w-14 text-center py-1 px-1 font-bold text-[11px] border-r border-slate-100 dark:border-slate-800\">\n468:                         {item.days}\n469:                       </div>\n470: \n471:                       {/* Cột Ghi Chú / GATE */}\n472:                       <div className=\"w-24 py-1 px-2 text-[10px] text-slate-400 truncate border-r border-slate-100 dark:border-slate-800\" title={item.notes}>\n473:                         {item.notes || '-'}\n474:                       </div>\n475: \n476:                       {/* Cột Thao Tác (Di chuyển lên/xuống & Xóa) */}\n477:                       <div className=\"w-20 flex items-center justify-center gap-0.5 py-1 px-1\">\n478:                         <button\n479:                           onClick={() => moveGanttItem(item.id, 'up')}\n480:                           className=\"p-1 rounded text-slate-400 hover:text-sky-500 hover:bg-sky-50 dark:hover:bg-slate-800 transition-colors\"\n481:                           title=\"Di chuyển lên trên\"\n482:                         >\n483:                           <ChevronUp className=\"w-3.5 h-3.5\" />\n484:                         </button>\n485:                         <button\n486:                           onClick={() => moveGanttItem(item.id, 'down')}\n487:                           className=\"p-1 rounded text-slate-400 hover:text-sky-500 hover:bg-sky-50 dark:hover:bg-slate-800 transition-colors\"\n488:                           title=\"Di chuyển xuống dưới\"\n489:                         >\n490:                           <ChevronDown className=\"w-3.5 h-3.5\" />\n491:                         </button>\n492:                         <button\n493:                           onClick={() => deleteGanttItem(item.id)}\n494:                           className=\"p-1 rounded text-slate-300 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition-colors\"\n495:                           title=\"Xóa công việc này\"\n496:                         >\n497:                           <Trash2 className=\"w-3.5 h-3.5\" />\n498:                         </button>\n499:                       </div>\n500: \n501:                     </div>\n502:                   );\n503:                 })}\n504:               </div>\n505: \n506:             </div>\n507: \n508:             {/* ================= KHUNG PHẢI: BIỂU ĐỒ GANTT NẰM BÊN PHẢI (SVG TƯƠNG TÁC) ================= */}\n509:             <div className=\"relative flex-1 bg-slate-50/50 dark:bg-slate-950/50\" st