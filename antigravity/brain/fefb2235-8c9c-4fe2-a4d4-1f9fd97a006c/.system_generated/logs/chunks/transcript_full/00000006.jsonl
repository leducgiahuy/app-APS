ame=\"w-3 h-3 rounded-full bg-amber-500 inline-block\" />\n354:           <span className=\"font-semibold text-slate-700 dark:text-slate-300\">L. Nghỉ lễ Việt Nam</span>\n355:         </div>\n356:         <div className=\"flex items-center gap-1.5\">\n357:           <span className=\"w-3 h-3 rounded-full bg-red-600 inline-block\" />\n358:           <span className=\"font-semibold text-slate-700 dark:text-slate-300\">B. Xin phép / Pháp lý</span>\n359:         </div>\n360:         <div className=\"flex items-center gap-1.5\">\n361:           <span className=\"w-3 h-3 rounded-full bg-green-600 inline-block\" />\n362:           <span className=\"font-semibold text-slate-700 dark:text-slate-300\">C. Mời thầu thi công</span>\n363:         </div>\n364:         <div className=\"flex items-center gap-1.5 ml-auto text-slate-500 dark:text-slate-400\">\n365:           <ArrowRight className=\"w-3.5 h-3.5 text-sky-500\" />\n366:           <span>Mũi tên liên kết Finish-to-Start (FS)</span>\n367:         </div>\n368:       </div>\n369: \n370:       {/* BẢNG TIẾN ĐỘ & BIỂU ĐỒ GANTT TƯƠNG TÁC (CỘT TRỜI ĐÓNG BĂNG) */}\n371:       <div className=\"rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden\">\n372:         \n373:         {/* Banner thông báo chế độ kéo ngang & đóng băng */}\n374:         <div className=\"px-4 py-2 bg-slate-800 text-white text-[11px] font-semibold flex items-center justify-between\">\n375:           <span className=\"flex items-center gap-2\">\n376:             <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n377:             CỘT TRỜI ĐÓNG BĂNG : KÉO THANH CUỘN NGANG ĐỂ XEM THANH TIẾN ĐỘ BAR\n378:           </span>\n379:           <span className=\"text-slate-400 font-mono text-[10px]\">\n380:             {filteredGanttItems.length} hạng mục công việc\n381:           </span>\n382:         </div>\n383: \n384:         {/* Khung cuộn ngang chứa cả Bảng bên trái + Biểu đồ bên phải */}\n385:         <div className=\"overflow-x-auto relative max-h-[700px] overflow-y-auto\">\n386:           <div className=\"flex\" style={{ width: `${680 + ganttWidth}px`, minWidth: '100%' }}>\n387:             \n388:             {/* ================= KHUNG TRÁI: BẢNG DỮ LIỆU CÔNG VIỆC (ĐÓNG BĂNG FREEZE) ================= */}\n389:             <div className=\"w-[680px] flex-shrink-0 sticky left-0 z-30 bg-white dark:bg-slate-900 border-r-2 border-slate-300 dark:border-slate-700 shadow-lg\">\n390:               \n391:               {/* Header Bảng Bên Trái */}\n392:               <div\n393:                 className=\"sticky top-0 z-40 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 flex items-center text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider\"\n394:                 style={{ height: `${HEADER_HEIGHT}px` }}\n395:               >\n396:                 <div className=\"w-12 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">STT</div>\n397:                 <div className=\"flex-1 py-2 px-3 border-r border-slate-200 dark:border-slate-700\">CÔNG VIỆC TRONG DỰ ÁN</div>\n398:                 <div className=\"w-14 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">ĐV</div>\n399:                 <div className=\"w-20 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">BẮT ĐẦU</div>\n400:                 <div className=\"w-20 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">KẾT THÚC</div>\n401:                 <div className=\"w-14 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">NGÀY</div>\n402:                 <div className=\"w-24 py-2 px-2 border-r border-slate-200 dark:border-slate-700\">GHI CHÚ</div>\n403:                 <div className=\"w-20 text-center py-2 px-1\">THAO TÁC</div>\n404:               </div>\n405: \n406:               {/* Danh Sách Các Hàng Công Việc (Tên dự án và công việc nằm bên tr