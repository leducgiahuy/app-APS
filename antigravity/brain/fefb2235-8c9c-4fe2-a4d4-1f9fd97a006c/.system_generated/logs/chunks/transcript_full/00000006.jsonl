{"step_index":242,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T03:49:17Z","content":"Created At: 2026-09-28T10:49:17+07:00\nCompleted At: 2026-09-28T10:49:17+07:00\nFile Path: `file:///C:/Users/GiaWyy/.gemini/antigravity/scratch/aps-project-manager/backend/src/controllers/taskController.js`\nTotal Lines: 266\nTotal Bytes: 7962\nShowing lines 1 to 160\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { readDb, writeDb } from '../models/db.js';\n2: import { compareWbs } from './projectController.js';\n3: \n4: /**\n5:  * Controller Quản Lý Phân Công & Tăng Ca\n6:  * Xử lý giao việc cho nhân sự, kiểm soát giờ làm việc chuẩn (8h/ngày),\n7:  * và đăng ký ca làm thêm giờ (Overtime / OT) cho các công việc gấp.\n8:  * ĐỒNG BỘ 2 CHIỀU HOÀN TOÀN VỚI BIỂU ĐỒ GANTT TIẾN ĐỘ DỰ ÁN.\n9:  */\n10: \n11: // Lấy danh sách nhiệm vụ và tăng ca\n12: export function getTasks(req, res) {\n13:   const db = readDb();\n14:   return res.json({\n15:     success: true,\n16:     data: {\n17:       tasks: db.tasks || [],\n18:       overtimes: db.overtimes || []\n19:     }\n20:   });\n21: }\n22: \n23: // Tạo nhiệm vụ mới (Task Assignment) - ĐỒNG BỘ SANG GANTT CHART\n24: export function createTask(req, res) {\n25:   const db = readDb();\n26:   const {\n27:     projectId,\n28:     projectName,\n29:     phase,\n30:     code,\n31:     title,\n32:     employeeId,\n33:     startDate,\n34:     endDate,\n35:     estimatedDays,\n36:     priority,\n37:     notes\n38:   } = req.body;\n39: \n40:   if (!title || !employeeId) {\n41:     return res.status(400).json({ success: false, message: 'Vui lòng nhập tên công việc và chọn người đảm nhận' });\n42:   }\n43: \n44:   // Tìm tên nhân sự\n45:   const emp = db.employees.find(e => e.id === employeeId);\n46:   const employeeName = emp ? emp.name : 'Chưa phân công';\n47: \n48:   // Tìm tên dự án nếu có\n49:   let projName = projectName;\n50:   if (!projName && projectId) {\n51:     const proj = db.projects.find(p => p.id === projectId);\n52:     if (proj) projName = proj.name;\n53:   }\n54: \n55:   const days = Number(estimatedDays) || 1;\n56:   const hours = days * 8; // 8 tiếng / ngày chuẩn\n57: \n58:   // Sinh mã WBS tự động nếu chưa có\n59:   let wbsCode = code ? String(code).trim() : '';\n60:   if (!wbsCode) {\n61:     let prefix = 'A';\n62:     if (phase && phase.includes('B.')) prefix = 'B';\n63:     else if (phase && phase.includes('C.')) prefix = 'C';\n64:     else if (phase && phase.includes('L.')) prefix = 'L';\n65:     \n66:     // Đếm số công việc hiện có trong nhóm prefix\n67:     const phaseItems = (db.ganttItems || []).filter(g => g.code.startsWith(prefix));\n68:     wbsCode = `${prefix}1.${phaseItems.length + 1}`;\n69:   }\n70: \n71:   const newGanttId = `G-${Date.now()}`;\n72: \n73:   const newTask = {\n74:     id: `task-${Date.now()}`,\n75:     ganttId: newGanttId,\n76:     projectId: projectId || 'proj-1',\n77:     projectName: projName || 'DỰ ÁN XÂY DỰNG TRUNG TÂM CÔNG NGHỆ APS VIỆT NAM',\n78:     phase: phase || 'A. THIẾT KẾ XÂY DỰNG',\n79:     code: wbsCode,\n80:     title,\n81:     employeeId,\n82:     employeeName,\n83:     startDate: startDate || new Date().toISOString().split('T')[0],\n84:     endDate: endDate || new Date().toISOString().split('T')[0],\n85:     estimatedHours: hours,\n86:     estimatedDays: days,\n87:     status: 'in_progress',\n88:     speedStatus: 'on_time', // 'early', 'on_time', 'delayed'\n89:     priority: priority || 'normal', // 'normal', 'high', 'urgent'\n90:     progress: 0,\n91:     notes: notes || ''\n92:   };\n93: \n94:   if (!db.tasks) db.tasks = [];\n95:   db.tasks.push(newTask);\n96: \n97:   // === ĐỒNG BỘ SANG TIẾN ĐỘ DỰ ÁN & BIỂU ĐỒ GANTT ===\n98:   let color = '#0284c7';\n99:   let unit = 'TK';\n100:   if (phase && phase.includes('B.')) {\n101:     color = '#ef4444';\n102:     unit = 'PL';\n103:   } else if (phase && phase.includes('C.')) {\n104:     color = '#22c55e';\n105:     unit = 'CDT';\n106:   } else if (phase && phase.includes('L.')) {\n107:     color = '#eab308';\n108:     unit = 'VN';\n109:   }\n110: \n111:   // Tự động tìm công việc đứng trước để nối đường mũi tên FS\n112:   let lastItemInPhase = null;\n113:   for (let i = db.ganttItems.length - 1; i >= 0; i--) {\n114:     if (db.ganttItems[i].code.startsWith(wbsCode.charAt(0))) {\n115:       lastItemInPhase = db.ganttItems[i];\n116:       break;\n117:     }\n118:   }\n119: \n120:   const newGanttItem = {\n121:     id: newGanttId,\n122:     code: wbsCode,\n123:     title,\n124:     isGroup: false,\n125:     color,\n126:     unit,\n127:     startDate: newTask.startDate,\n128:     endDate: newTask.endDate,\n129:     days: newTask.estimatedDays,\n130:     assignee: employeeName,\n131:     notes: notes || '',\n132:     status: 'in_progress',\n133:     speed: 'on_time',\n134:     progress: 0,\n135:     dependencies: lastItemInPhase ? [lastItemInPhase.id] : []\n136:   };\n137: \n138:   // Chèn vào Gantt theo thuật toán WBS (đúng vị trí cây phân cấp)\n139:   let insertIdx = -1;\n140:   for (let i = 0; i < db.ganttItems.length; i++) {\n141:     if (compareWbs(db.ganttItems[i].code, newGanttItem.code) < 0) {\n142:       insertIdx = i;\n143:     }\n144:   }\n145:   if (insertIdx === -1) {\n146:     db.ganttItems.unshift(newGanttItem);\n147:   } else {\n148:     db.ganttItems.splice(insertIdx + 1, 0, newGanttItem);\n149:   }\n150: \n151:   writeDb(db);\n152: \n153:   return res.status(201).json({\n154:     success: true,\n155:     message: `Phân công nhiệm vụ thành công và đã đồng bộ sang biểu đồ Gantt (${wbsCode})`,\n156:     data: newTask\n157:   });\n158: }\n159: \n160: // Cập nhật trạng thái nhiệm vụ (đồng bộ sang Gantt)\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
