=> (\n583:                   <line\n584:                     key={idx}\n585:                     x1=\"0\"\n586:                     y1={HEADER_HEIGHT + idx * ROW_HEIGHT}\n587:                     x2={ganttWidth}\n588:                     y2={HEADER_HEIGHT + idx * ROW_HEIGHT}\n589:                     stroke=\"#e2e8f0\"\n590:                     strokeWidth=\"1\"\n591:                     className=\"dark:stroke-slate-800/60\"\n592:                   />\n593:                 ))}\n594: \n595:                 {/* 2. HIỂN THỊ MŨI TÊN KẺ XUỐNG CÔNG VIỆC TIẾP THEO TRONG DỰ ÁN (FS Dependency) */}\n596:                 {dependencyLines.map((line) => (\n597:                   <path\n598:                     key={line.key}\n599:                     d={line.path}\n600:                     fill=\"none\"\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
