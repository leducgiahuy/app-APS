{"step_index":240,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T03:49:14Z","content":"Created At: 2026-09-28T10:49:14+07:00\nCompleted At: 2026-09-28T10:49:14+07:00\nFile Path: `file:///C:/Users/GiaWyy/.gemini/antigravity/scratch/aps-project-manager/backend/src/controllers/projectController.js`\nTotal Lines: 303\nTotal Bytes: 9425\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import { readDb, writeDb } from '../models/db.js';\n2: \n3: /**\n4:  * Controller Quản Lý Tiến Độ Dự Án & Biểu Đồ Gantt Công Trường\n5:  * Xử lý dữ liệu WBS (Phân rã công việc), mốc thời gian, liên kết phụ thuộc FS,\n6:  * và thuật toán sắp xếp phân tầng WBS tự động (VD: A1.3 tự động nằm sau A1.2).\n7:  * ĐỒNG BỘ 2 CHIỀU VỚI DANH SÁCH NHIỆM VỤ (TASKS) VÀ NHÂN SỰ (HR).\n8:  */\n9: \n10: // Thứ tự ưu tiên của các khối giai đoạn lớn theo mẫu tiến độ công trình\n11: const MAJOR_PHASE_ORDER = ['A', 'L', 'B', 'C', 'D', 'E', 'F', 'G'];\n12: \n13: /**\n14:  * Phân tích mã WBS (VD: 'A1.3' -> { majorIdx: 0, segments: [1, 3] })\n15:  */\n16: export function parseWbsCode(code) {\n17:   if (!code) return { majorIdx: 999, segments: [] };\n18:   const cleaned = String(code).trim();\n19:   const match = cleaned.match(/^([A-Za-z]+)(.*)$/);\n20:   if (!match) return { majorIdx: 999, segments: [cleaned] };\n21: \n22:   const letter = match[1].toUpperCase();\n23:   const rest = match[2];\n24: \n25:   let majorIdx = MAJOR_PHASE_ORDER.indexOf(letter);\n26:   if (majorIdx === -1) majorIdx = 100 + letter.charCodeAt(0);\n27: \n28:   const segments = rest\n29:     ? rest\n30:         .split('.')\n31:         .map(s => {\n32:           const num = parseInt(s, 10);\n33:           return isNaN(num) ? s : num;\n34:         })\n35:     : [];\n36: \n37:   return { majorIdx, segments };\n38: }\n39: \n40: /**\n41:  * So sánh 2 mã WBS để sắp xếp đúng thứ tự cây phân tầng\n42:  * Ví dụ: A1 < A1.1 < A1.2 < A1.3 < A2 < A2.1 < L < B\n43:  */\n44: export function compareWbs(codeA, codeB) {\n45:   const pa = parseWbsCode(codeA);\n46:   const pb = parseWbsCode(codeB);\n47: \n48:   // So sánh nhóm giai đoạn lớn trước (A trước L, L trước B, B trước C)\n49:   if (pa.majorIdx !== pb.majorIdx) {\n50:     return pa.majorIdx - pb.majorIdx;\n51:   }\n52: \n53:   // So sánh từng cấp số con bên trong\n54:   const maxLen = Math.max(pa.segments.length, pb.segments.length);\n55:   for (let i = 0; i < maxLen; i++) {\n56:     const sa = pa.segments[i];\n57:     const sb = pb.segments[i];\n58: \n59:     if (sa === undefined) return -1; // Cấp cha ngắn hơn đứng trước (A1 đứng trước A1.1)\n60:     if (sb === undefined) return 1;\n61: \n62:     if (typeof sa === 'number' && typeof sb === 'number') {\n63:       if (sa !== sb) return sa - sb;\n64:     } else {\n65:       const cmp = String(sa).localeCompare(String(sb));\n66:       if (cmp !== 0) return cmp;\n67:     }\n68:   }\n69: \n70:   return 0;\n71: }\n72: \n73: // Lấy danh sách dự án\n74: export function getProjects(req, res) {\n75:   const db = readDb();\n76:   return res.json({\n77:     success: true,\n78:     data: db.projects || []\n79:   });\n80: }\n81: \n82: // Tạo dự án mới\n83: export function createProject(req, res) {\n84:   const db = readDb();\n85:   const { name, code, description, location, manager, startDate, endDate } = req.body;\n86: \n87:   if (!name) {\n88:     return res.status(400).json({ success: false, message: 'Vui lòng nhập tên dự án' });\n89:   }\n90: \n91:   const newProject = {\n92:     id: `proj-${Date.now()}`,\n93:     code: code || `APS-${new Date().getFullYear()}-${db.projects.length + 1}`,\n94:     name,\n95:     description: description || '',\n96:     location: location || 'Hà Nội',\n97:     manager: manager || 'Trần Quốc Hưng',\n98:     startDate: startDate || new Date().toISOString().split('T')[0],\n99:     endDate: endDate || '2027-12-31',\n100:     status: 'planning',\n101:     progress: 0\n102:   };\n103: \n104:   db.projects.push(newProject);\n105:   writeDb(db);\n106: \n107:   return res.status(201).json({\n108:     success: true,\n109:     message: 'Tạo dự án mới thành công',\n110:     data: newProject\n111:   });\n112: }\n113: \n114: // Lấy danh sách hạng mục cho biểu đồ Gantt\n115: export function getGanttItems(req, res) {\n116:   const db = readDb();\n117:   return res.json({\n118:     success: true,\n119:     data: db.ganttItems || []\n120:   });\n121: }\n122: \n123: // Thêm mới công việc vào biểu đồ Gantt dự án\n124: // TỰ ĐỘNG CHÈN ĐÚNG VỊ TRÍ PHÂN TẦNG WBS (VD: A1.3 NẰM SAU A1.2) VÀ ĐỒNG BỘ SANG TASKS\n125: export function createGanttItem(req, res) {\n126:   const db = readDb();\n127:   const {\n128:     code,\n129:     title,\n130:     isGroup,\n131:     unit,\n132:     startDate,\n133:     endDate,\n134:     days,\n135:     assignee,\n136:     notes,\n137:     color,\n138:     dependencies,\n139:     speed,\n140:     insertAfterId // Tùy chọn: người dùng chỉ định chèn cụ thể sau công việc nào\n141:   } = req.body;\n142: \n143:   if (!title || !startDate || !endDate) {\n144:     return res.status(400).json({ success: false, message: 'Vui lòng nhập đầy đủ tên công việc, ngày bắt đầu và ngày kết thúc' });\n145:   }\n146: \n147:   const start = new Date(startDate);\n148:   const end = new Date(endDate);\n149:   const calculatedDays = days ? Number(days) : Math.max(1, Math.round((end - start) / (1000 * 60 * 60 * 24)) + 1);\n150: \n151:   const formattedCode = code ? String(code).trim() : `T${db.ganttItems.length + 1}`;\n152:   const newGanttId = `G-${Date.now()}`;\n153: \n154:   // === 1. TÍNH TOÁN VỊ TRÍ CHÈN WBS ===\n155:   let insertIdx = -1;\n156:   if (insertAfterId) {\n157:     insertIdx = db.ganttItems.findIndex(g => g.id === insertAfterId);\n158:   } else {\n159:     for (let i = 0; i < db.ganttItems.length; i++) {\n160:       if (compareWbs(db.ganttItems[i].code, formattedCode) < 0) {\n161:         insertIdx = i;\n162:       }\n163:     }\n164:   }\n165: \n166:   // === 2. TỰ ĐỘNG TẠO ĐƯỜNG MŨI TÊN LIÊN KẾT FS NỐI XUỐNG ===\n167:   let autoDependencies = Array.isArray(dependencies) ? [...dependencies] : [];\n168:   if (autoDependencies.length === 0 && !isGroup) {\n169:     // Tự động liên kết tới công việc đứng ngay trước đó để vẽ đường nối xuống\n170:     if (insertIdx >= 0 && db.ganttItems[insertIdx]) {\n171:       autoDependencies.push(db.ganttItems[insertIdx].id);\n172:     }\n173:   }\n174: \n175:   const newItem = {\n176:     id: newGanttId,\n177:     code: formattedCode,\n178:     title,\n179:     isGroup: Boolean(isGroup),\n180:     color: color || '#0284c7',\n181:     unit: unit || 'TK',\n182:     startDate,\n183:     endDate,\n184:     days: calculatedDays,\n185:     assignee: assignee || 'Trần Quốc Hưng',\n186:     notes: notes || '',\n187:     status: 'in_progress',\n188:     speed: speed || 'on_time',\n189:     progress: 0,\n190:     dependencies: autoDependencies\n191:   };\n192: \n193:   // Chèn vào mảng ganttItems\n194:   if (insertIdx === -1) {\n195:     db.ganttItems.unshift(newItem);\n196:   } else {\n197:     db.ganttItems.splice(insertIdx + 1, 0, newItem);\n198:   }\n199: \n200:   // === 3. ĐỒNG BỘ SANG MỤC 1 (PHÂN CÔNG CÔNG VIỆC) & TRANG NHÂN SỰ ===\n201:   if (!isGroup) {\n202:     // Tìm nhân sự tương ứng\n203:     const empNameNorm = (newItem.assignee || '').trim().toLowerCase();\n204:     const emp = db.employees.find(e => e.name.trim().toLowerCase() === empNameNorm) || db.employees[0];\n205: \n206:     // Xác định tên giai đoạn (Phase)\n207:     let phaseName = 'A. THIẾT KẾ XÂY DỰNG';\n208:     const upperCode = newItem.code.toUpperCase();\n209:     if (upperCode.startsWith('B')) phaseName = 'B. XIN PHÉP / PHÁP LÝ';\n210:     else if (upperCode.startsWith('C')) phaseName = 'C. MỜI THẦU THI CÔNG';\n211:     else if (upperCode.startsWith('L')) phaseName = 'L. NGHỈ LỄ VIỆT NAM';\n212: \n213:     const matchedTask = {\n214:       id: `task-${Date.now()}`,\n215:       ganttId: newItem.id,\n216:       projectId: 'proj-1',\n217:       projectName: 'DỰ ÁN XÂY DỰNG TRUNG TÂM CÔNG NGHỆ APS VIỆT NAM',\n218:       phase: phaseName,\n219:       title: newItem.title,\n220:       code: newItem.code,\n221:       employeeId: emp ? emp.id : 'emp-1',\n222:       employeeName: emp ? emp.name : newItem.assignee,\n223:       startDate: newItem.startDate,\n224:       endDate: newItem.endDate,\n225:       estimatedHours: newItem.days * 8,\n226:       estimatedDays: newItem.days,\n227:       status: 'in_progress',\n228:       speedStatus: newItem.speed || 'on_time',\n229:       priority: 'high',\n230:       progress: 0,\n231:       notes: newItem.notes || ''\n232:     };\n233: \n234:     // Đẩy vào db.tasks\n235:     if (!db.tasks) db.tasks = [];\n236:     db.tasks.push(matchedTask);\n237:   }\n238: \n239:   writeDb(db);\n240: \n241:   return res.status(201).json({\n242:     success: true,\n243:     message: `Đã thêm công việc \"${newItem.title}\" (${newItem.code}) vào đúng vị trí tiến độ và đồng bộ sang danh sách nhiệm vụ`,\n244:     data: newItem\n245:   });\n246: }\n247: \n248: // Di chuyển công việc lên / xuống (Reorder)\n249: export function moveGanttItem(req, res) {\n250:   const db = readDb();\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
