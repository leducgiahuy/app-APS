:     if (!window.confirm('Bạn có chắc chắn muốn xóa công việc này?')) return;\n194:     try {\n195:       await api.deleteTask(id);\n196:       showToast('Đã xóa công việc');\n197:       setTasks(prev => prev.filter(t => t.id !== id));\n198:     } catch (err) {\n199:       showToast('Lỗi khi xóa công việc', 'error');\n200:     }\n201:   };\n202: \n203:   // Hành động: Đăng ký tăng ca (OT)\n204:   const addOvertime = async (otData) => {\n205:     try {\n206:       await api.createOvertime(otData);\n207:       showToast('Đăng ký ca tăng ca (OT) thành công');\n208:       refreshAllData();\n209:       return true;\n210:     } catch (err) {\n211:       showToast(err.message || 'Lỗi khi đăng ký tăng ca', 'error');\n212:       return false;\n213:     }\n214:   };\n215: \n216:   // Hành động: Tạo dự án mới\n217:   const addProject = async (projectData) => {\n218:     try {\n219:       await api.createProject(projectData);\n220:       showToast('Tạo dự án mới thành công');\n221:       refreshAllData();\n222:       return true;\n223:     } catch (err) {\n224:       showToast(err.message || 'Lỗi khi tạo dự án', 'error');\n225:       return false;\n226:     }\n227:   };\n228: \n229:   // Hành động: Thêm công việc vào Gantt (Tự động chèn theo WBS hoặc theo vị trí đã chọn)\n230:   const addGanttItem = async (itemData) => {\n231:     try {\n232:       const res = await api.createGanttItem(itemData);\n233:       showToast(res.message || 'Thêm công việc vào tiến độ thành công');\n234:       await refreshAllData();\n235:       return true;\n236:     } catch (err) {\n237:       showToast(err.message || 'Lỗi khi thêm vào Gantt', 'error');\n238:       return false;\n239:     }\n240:   };\n241: \n242:   // Hành động: Di chuyển công việc lên / xuống (Reorder)\n243:   const moveGanttItem = async (id, direction) => {\n244:     try {\n245:       const res = await api.moveGanttItem(id, direction);\n246:       if (res.data) {\n247:         setGanttItems(res.data);\n248:       } else {\n249:         await refreshAllData();\n250:       }\n251:       showToast(res.message || 'Đã cập nhật thứ tự công việc');\n252:       return true;\n253:     } catch (err) {\n254:       showToast('Lỗi khi đổi thứ tự', 'error');\n255:       return false;\n256:     }\n257:   };\n258: \n259:   // Hành động: Xóa công việc khỏi Gantt\n260:   const deleteGanttItem = async (id) => {\n261:     if (!window.confirm('Bạn có chắc chắn muốn xóa hạng mục này khỏi tiến độ?')) return;\n262:     try {\n263:       await api.deleteGanttItem(id);\n264:       showToast('Đã xóa hạng mục khỏi biểu đồ Gantt');\n265:       setGanttItems(prev => prev.filter(g => g.id !== id));\n266:     } catch (err) {\n267:       showToast('Lỗi khi xóa hạng mục', 'error');\n268:     }\n269:   };\n270: \n271:   return (\n272:     <AppContext.Provider\n273:       value={{\n274:         theme,\n275:         toggleTheme,\n276:         activeTab,\n277:         setActiveTab,\n278:         currentTime,\n279:         selectedDate,\n280:         setSelectedDate,\n281:         goToPrevDay,\n282:         goToNextDay,\n283:         goToToday,\n284:         sidebarCollapsed,\n285:         setSidebarCollapsed,\n286:         mobileMenuOpen,\n287:         setMobileMenuOpen,\n288:         employees,\n289:         tasks,\n290:         overtimes,\n291:         ganttItems,\n292:         projects,\n293:         stats,\n294:         loading,\n295:         toast,\n296:         showToast,\n297:         refreshAllData,\n298:         toggleOnSite,\n299:         addEmployee,\n300:         deleteEmployee,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
