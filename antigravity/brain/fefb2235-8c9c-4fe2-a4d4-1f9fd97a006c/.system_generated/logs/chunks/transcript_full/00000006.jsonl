{"step_index":230,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-28T03:48:39Z","content":"Created At: 2026-09-28T10:48:39+07:00\nCompleted At: 2026-09-28T10:48:40+07:00\nFile Path: `file:///C:/Users/GiaWyy/.gemini/antigravity/scratch/aps-project-manager/frontend/src/modules/gantt/GanttPage.jsx`\nTotal Lines: 1004\nTotal Bytes: 45273\nShowing lines 1 to 250\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React, { useState, useMemo, useRef } from 'react';\n2: import { useApp } from '../../context/AppContext';\n3: import {\n4:   CalendarRange,\n5:   Plus,\n6:   Trash2,\n7:   Building,\n8:   Layers,\n9:   Clock,\n10:   Flame,\n11:   ArrowRight,\n12:   Maximize2,\n13:   Calendar,\n14:   AlertCircle,\n15:   CheckCircle,\n16:   HelpCircle,\n17:   ChevronUp,\n18:   ChevronDown\n19: } from 'lucide-react';\n20: \n21: export default function GanttPage() {\n22:   const {\n23:     ganttItems,\n24:     projects,\n25:     employees,\n26:     addGanttItem,\n27:     moveGanttItem,\n28:     deleteGanttItem,\n29:     addProject\n30:   } = useApp();\n31: \n32:   // Chọn dự án đang xem\n33:   const [selectedProjectId, setSelectedProjectId] = useState(projects[0]?.id || 'proj-1');\n34: \n35:   // Bộ lọc giai đoạn\n36:   const [phaseFilter, setPhaseFilter] = useState('ALL');\n37: \n38:   // Chế độ thu phóng (Zoom: 'day' | 'week' | 'month')\n39:   const [zoomLevel, setZoomLevel] = useState('week'); // 1 day = 18px (day), 1 day = 6px (week), 1 day = 3px (month)\n40: \n41:   // Trạng thái modal\n42:   const [showAddTaskModal, setShowAddTaskModal] = useState(false);\n43:   const [showAddProjectModal, setShowAddProjectModal] = useState(false);\n44: \n45:   // Form thêm công việc cho dự án\n46:   const [taskForm, setTaskForm] = useState({\n47:     code: '',\n48:     title: '',\n49:     isGroup: false,\n50:     unit: 'TK',\n51:     startDate: '2026-11-01',\n52:     endDate: '2026-11-05',\n53:     days: 5,\n54:     assignee: employees[0]?.name || 'Trần Quốc Hưng',\n55:     notes: '',\n56:     color: '#0284c7',\n57:     dependencies: [],\n58:     speed: 'on_time',\n59:     insertAfterId: ''\n60:   });\n61: \n62:   // Form tạo dự án\n63:   const [projectForm, setProjectForm] = useState({\n64:     name: '',\n65:     code: '',\n66:     description: '',\n67:     location: 'Hà Nội',\n68:     manager: 'Trần Quốc Hưng',\n69:     startDate: '2026-11-01',\n70:     endDate: '2027-07-02'\n71:   });\n72: \n73:   // Tính toán thời gian bắt đầu và kết thúc tổng thể của Gantt\n74:   // Khung thời gian theo ảnh mẫu: Tháng 11/2026 đến Tháng 07/2027\n75:   const timelineStart = useMemo(() => new Date('2026-11-01T00:00:00'), []);\n76:   const timelineEnd = useMemo(() => new Date('2027-07-15T23:59:59'), []);\n77: \n78:   // Tính tỷ lệ pixel theo ngày dựa trên zoom level\n79:   const pxPerDay = useMemo(() => {\n80:     if (zoomLevel === 'day') return 18;\n81:     if (zoomLevel === 'week') return 7.5;\n82:     return 3.8;\n83:   }, [zoomLevel]);\n84: \n85:   // Tổng số ngày trong timeline\n86:   const totalTimelineDays = useMemo(() => {\n87:     return Math.ceil((timelineEnd - timelineStart) / (1000 * 60 * 60 * 24));\n88:   }, [timelineStart, timelineEnd]);\n89: \n90:   // Chiều rộng tổng của biểu đồ SVG\n91:   const ganttWidth = Math.max(1200, totalTimelineDays * pxPerDay);\n92: \n93:   // Danh sách các cột tháng (T11/26, T12/26, T1/27, T2/27, T3/27, T4/27, T5/27, T6/27, T7/27)\n94:   const monthColumns = useMemo(() => {\n95:     const months = [];\n96:     const curr = new Date(timelineStart);\n97:     while (curr <= timelineEnd) {\n98:       const year = curr.getFullYear();\n99:       const month = curr.getMonth();\n100:       const monthStart = new Date(year, month, 1);\n101:       const nextMonth = new Date(year, month + 1, 1);\n102:       const monthEnd = nextMonth > timelineEnd ? timelineEnd : new Date(nextMonth - 1);\n103: \n104:       const daysFromStart = Math.max(0, (monthStart - timelineStart) / (1000 * 60 * 60 * 24));\n105:       const monthDays = (monthEnd - monthStart) / (1000 * 60 * 60 * 24) + 1;\n106: \n107:       months.push({\n108:         label: `T${month + 1}/${String(year).slice(2)}`,\n109:         left: daysFromStart * pxPerDay,\n110:         width: monthDays * pxPerDay\n111:       });\n112: \n113:       curr.setMonth(curr.getMonth() + 1);\n114:     }\n115:     return months;\n116:   }, [timelineStart, timelineEnd, pxPerDay]);\n117: \n118:   // Lọc các item trong Gantt\n119:   const filteredGanttItems = useMemo(() => {\n120:     if (phaseFilter === 'ALL') return ganttItems;\n121:     if (phaseFilter === 'A') return ganttItems.filter(g => g.code.startsWith('A'));\n122:     if (phaseFilter === 'L') return ganttItems.filter(g => g.code.startsWith('L'));\n123:     if (phaseFilter === 'B') return ganttItems.filter(g => g.code.startsWith('B'));\n124:     if (phaseFilter === 'C') return ganttItems.filter(g => g.code.startsWith('C'));\n125:     return ganttItems;\n126:   }, [ganttItems, phaseFilter]);\n127: \n128:   // Chiều cao mỗi dòng trong bảng & biểu đồ (khóa cứng pixel để không bị lệch)\n129:   const ROW_HEIGHT = 44;\n130:   const HEADER_HEIGHT = 52;\n131:   const BAR_HEIGHT = 24;\n132: \n133:   // Tính tọa độ vị trí (x, width, y) của từng thanh Gantt\n134:   const taskCoordinates = useMemo(() => {\n135:     const coords = {};\n136:     filteredGanttItems.forEach((item, index) => {\n137:       const sDate = new Date(item.startDate);\n138:       const eDate = new Date(item.endDate);\n139: \n140:       const offsetDays = Math.max(0, (sDate - timelineStart) / (1000 * 60 * 60 * 24));\n141:       const durationDays = Math.max(1, (eDate - sDate) / (1000 * 60 * 60 * 24) + 1);\n142: \n143:       const x = offsetDays * pxPerDay;\n144:       const width = Math.max(16, durationDays * pxPerDay);\n145:       // Tọa độ Y chính xác căn giữa từng dòng 44px\n146:       const y = HEADER_HEIGHT + index * ROW_HEIGHT + (ROW_HEIGHT - BAR_HEIGHT) / 2;\n147:       const centerY = HEADER_HEIGHT + index * ROW_HEIGHT + ROW_HEIGHT / 2;\n148: \n149:       coords[item.id] = {\n150:         x,\n151:         y,\n152:         width,\n153:         height: BAR_HEIGHT,\n154:         endX: x + width,\n155:         centerY,\n156:         item\n157:       };\n158:     });\n159:     return coords;\n160:   }, [filteredGanttItems, timelineStart, pxPerDay]);\n161: \n162:   // Tạo đường cong mũi tên phụ thuộc Finish-to-Start (FS) - TỰ ĐỘNG NỐI TỪ TASK TRƯỚC XUỐNG\n163:   const dependencyLines = useMemo(() => {\n164:     const lines = [];\n165:     filteredGanttItems.forEach((item, toIndex) => {\n166:       let deps = Array.isArray(item.dependencies) ? [...item.dependencies] : [];\n167: \n168:       // Nếu là công việc con và chưa có liên kết, tự động nối từ công việc đứng ngay trước đó\n169:       if (deps.length === 0 && !item.isGroup && toIndex > 0) {\n170:         const prevItem = filteredGanttItems[toIndex - 1];\n171:         if (prevItem && !prevItem.isGroup) {\n172:           deps = [prevItem.id];\n173:         }\n174:       }\n175: \n176:       deps.forEach((depId) => {\n177:         const from = taskCoordinates[depId];\n178:         const to = taskCoordinates[item.id];\n179:         if (from && to) {\n180:           const startX = from.endX;\n181:           const startY = from.centerY;\n182:           const targetX = to.x;\n183:           const targetY = to.centerY;\n184: \n185:           let pathData = '';\n186:           if (targetX >= startX) {\n187:             const midX = startX + 12;\n188:             pathData = `M ${startX} ${startY} L ${midX} ${startY} L ${midX} ${targetY} L ${targetX} ${targetY}`;\n189:           } else {\n190:             const loopX = startX + 10;\n191:             const approachX = targetX - 10;\n192:             const stepY = startY + (targetY > startY ? 14 : -14);\n193:             pathData = `M ${startX} ${startY} L ${loopX} ${startY} L ${loopX} ${stepY} L ${approachX} ${stepY} L ${approachX} ${targetY} L ${targetX} ${targetY}`;\n194:           }\n195: \n196:           lines.push({\n197:             key: `${depId}->${item.id}`,\n198:             path: pathData,\n199:             targetX,\n200:             targetY\n201:           });\n202:         }\n203:       });\n204:     });\n205:     return lines;\n206:   }, [filteredGanttItems, taskCoordinates]);\n207: \n208:   // Xử lý gửi Form thêm Task\n209:   const handleTaskSubmit = async (e) => {\n210:     e.preventDefault();\n211:     if (!taskForm.title) return;\n212:     const success = await addGanttItem(taskForm);\n213:     if (success) {\n214:       setTaskForm({\n215:         code: '',\n216:         title: '',\n217:         isGroup: false,\n218:         unit: 'TK',\n219:         startDate: '2026-11-01',\n220:         endDate: '2026-11-05',\n221:         days: 5,\n222:         assignee: employees[0]?.name || 'Trần Quốc Hưng',\n223:         notes: '',\n224:         color: '#0284c7',\n225:         dependencies: [],\n226:         speed: 'on_time',\n227:         insertAfterId: ''\n228:       });\n229:       setShowAddTaskModal(false);\n230:     }\n231:   };\n232: \n233:   // Xử lý gửi Form thêm Project\n234:   const handleProjectSubmit = async (e) => {\n235:     e.preventDefault();\n236:     if (!projectForm.name) return;\n237:     const success = await addProject(projectForm);\n238:     if (success) {\n239:       setProjectForm({\n240:         name: '',\n241:         code: '',\n242:         description: '',\n243:         location: 'Hà Nội',\n244:         manager: 'Trần Quốc Hưng',\n245:         startDate: '2026-11-01',\n246:         endDate: '2027-07-02'\n247:       });\n248:       setShowAddProjectModal(false);\n249:     }\n250:   };\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
