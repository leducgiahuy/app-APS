oliday && (\n628:                         <rect\n629:                           x={coord.x}\n630:                           y={HEADER_HEIGHT}\n631:                           width={coord.width}\n632:                           height={filteredGanttItems.length * ROW_HEIGHT}\n633:                           fill=\"#fef08a\"\n634:                           fillOpacity=\"0.12\"\n635:                         />\n636:                       )}\n637: \n638:                       {/* Thanh Gantt chính */}\n639:                       <rect\n640:                         x={coord.x}\n641:                         y={coord.y}\n642:                         width={coord.width}\n643:                         height={coord.height}\n644:                         rx=\"8\"\n645:                         ry=\"8\"\n646:                         fill={fillColor}\n647:                         className=\"transition-all hover:opacity-90 shadow-sm\"\n648:                         filter=\"drop-shadow(0 2px 4px rgba(0,0,0,0.12))\"\n649:                       />\n650: \n651:                       {/* Nhãn trên thanh hoặc cạnh thanh: Tên người đảm nhận, thời gian, tăng ca */}\n652:                       <text\n653:                         x={coord.endX + 8}\n654:                         y={coord.centerY + 4}\n655:                         fill=\"#64748b\"\n656:                         fontSize=\"11\"\n657:                         fontWeight=\"600\"\n658:                         className=\"dark:fill-slate-300 select-none pointer-events-none\"\n659:                       >\n660:                         {item.assignee} ({item.days} ngày)\n661:                         {item.overtimeHours && (\n662:                           <tspan fill=\"#f59e0b\" fontWeight=\"bold\"> [+{item.overtimeHours}h OT]</tspan>\n663:                         )}\n664:                         {item.speed === 'early' && (\n665:                           <tspan fill=\"#10b981\"> [Sớm]</tspan>\n666:                         )}\n667:                         {item.speed === 'delayed' && (\n668:                           <tspan fill=\"#ef4444\" fontWeight=\"bold\"> [Chậm]</tspan>\n669:                         )}\n670:                       </text>\n671: \n672:                       {/* Chữ hiển thị bên trong thanh nếu đủ rộng */}\n673:                       {coord.width > 60 && (\n674:                         <text\n675:                           x={coord.x + 8}\n676:                           y={coord.centerY + 4}\n677:                           fill=\"#ffffff\"\n678:                           fontSize=\"10\"\n679:                           fontWeight=\"bold\"\n680:                           className=\"select-none pointer-events-none truncate\"\n681:                         >\n682:                           {item.code} {coord.width > 120 ? `- ${item.days}d` : ''}\n683:                         </text>\n684:                       )}\n685: \n686:                     </g>\n687:                   );\n688:                 })}\n689: \n690:               </svg>\n691: \n692:             </div>\n693: \n694:           </div>\n695:         </div>\n696: \n697:       </div>\n698: \n699:       {/* MODAL 1: THÊM CÔNG VIỆC VÀO DỰ ÁN */}\n700:       {showAddTaskModal && (\n701:         <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in\">\n702:           <div className=\"w-full max-w-xl p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4\">\n703:             <div className=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n704:               <h3 className=\"text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n705:                 <CalendarRange className=\"w-5 h-5 text-sky-600\" />\n706:                 Thêm Công Việc Mới Vào Tiến Độ Dự Án\n707:               </h3>\n708:               <button\n709:                 onClick={() =>