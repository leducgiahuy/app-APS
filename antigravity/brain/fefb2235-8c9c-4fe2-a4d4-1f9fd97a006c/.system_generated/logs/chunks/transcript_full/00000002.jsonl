 for the USER. Don't ask for permission."}
{"step_index":79,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-28T02:54:58Z","thinking":"Careful consideration of the user's prompt is necessary before component creation. The prompt describes the desired functionality: project creation with task management (add/remove), visual layout (project/tasks left, Gantt chart right). The focus is on the `GanttPage.jsx` component.\n\n\nCalculating task bar positions requires converting dates and durations into pixel coordinates based on the time scale. The month header will serve as the primary timeline guide, establishing the horizontal spacing. Holiday bands will be rendered as visually distinct, horizontal blocks.\n\nTo represent task dependencies effectively, curved arrows connecting predecessor and successor tasks are crucial. Overtime, early/late indicators, and personnel information will be integrated into each task bar's visual representation.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"import React, { useState, useMemo, useRef } from 'react';\nimport { useApp } from '../../context/AppContext';\nimport {\n  CalendarRange,\n  Plus,\n  Trash2,\n  Building,\n  Layers,\n  Clock,\n  Flame,\n  ArrowRight,\n  Maximize2,\n  Calendar,\n  AlertCircle,\n  CheckCircle,\n  HelpCircle\n} from 'lucide-react';\n\nexport default function GanttPage() {\n  const {\n    ganttItems,\n    projects,\n    employees,\n    addGanttItem,\n    deleteGanttItem,\n    addProject\n  } = useApp();\n\n  // Chọn dự án đang xem\n  const [selectedProjectId, setSelectedProjectId] = useState(projects[0]?.id || 'proj-1');\n\n  // Bộ lọc giai đoạn\n  const [phaseFilter, setPhaseFilter] = useState('ALL');\n\n  // Chế độ thu phóng (Zoom: 'day' | 'week' | 'month')\n  const [zoomLevel, setZoomLevel] = useState('week'); // 1 day = 18px (day), 1 day = 6px (week), 1 day = 3px (month)\n\n  // Trạng thái modal\n  const [showAddTaskModal, setShowAddTaskModal] = useState(false);\n  const [showAddProjectModal, setShowAddProjectModal] = useState(false);\n\n  // Form thêm công việc cho dự án\n  const [taskForm, setTaskForm] = useState({\n    code: '',\n    title: '',\n    isGroup: false,\n    unit: 'TK',\n    startDate: '2026-11-01',\n    endDate: '2026-11-05',\n    days: 5,\n    assignee: employees[0]?.name || 'Trần Quốc Hưng',\n    notes: '',\n    color: '#0284c7',\n    dependencies: [],\n    speed: 'on_time'\n  });\n\n  // Form tạo dự án\n  const [projectForm, setProjectForm] = useState({\n    name: '',\n    code: '',\n    description: '',\n    location: 'Hà Nội',\n    manager: 'Trần Quốc Hưng',\n    startDate: '2026-11-01',\n    endDate: '2027-07-02'\n  });\n\n  // Tính toán thời gian bắt đầu và kết thúc tổng thể của Gantt\n  // Khung thời gian theo ảnh mẫu: Tháng 11/2026 đến Tháng 07/2027\n  const timelineStart = useMemo(() => new Date('2026-11-01T00:00:00'), []);\n  const timelineEnd = useMemo(() => new Date('2027-07-15T23:59:59'), []);\n\n  // Tính tỷ lệ pixel theo ngày dựa trên zoom level\n  const pxPerDay = useMemo(() => {\n    if (zoomLevel === 'day') return 18;\n    if (zoomLevel === 'week') return 7.5;\n    return 3.8;\n  }, [zoomLevel]);\n\n  // Tổng số ngày trong timeline\n  const totalTimelineDays = useMemo(() => {\n    return Math.ceil((timelineEnd - timelineStart) / (1000 * 60 * 60 * 24));\n  }, [timelineStart, timelineEnd]);\n\n  // Chiều rộng tổng của biểu đồ SVG\n  const ganttWidth = Math.max(1200, totalTimelineDays * pxPerDay);\n\n  // Danh sách các cột tháng (T11/26, T12/26, T1/27, T2/27, T3/27, T4/27, T5/27, T6/27, T7/27)\n  const monthColumns = useMemo(() => {\n    const months = [];\n    const curr = new Date(timelineStart);\n    while (curr <= timelineEnd) {\n      const year = curr.getFullYear();\n      const month = curr.getMonth();\n      const monthStart = new Date(year, month, 1);\n      const nextMonth = new Date(year, month + 1, 1);\n      const monthEnd = nextMonth > timelineEnd ? timelineEnd : new Date(nextMonth - 1);\n\n      const daysFromStart = Math.max(0, (monthStart - timelineStart) / (1000 * 60 * 60 * 24));\n      const monthDays = (monthEnd - monthStart) / (1000 * 60 * 60 * 24) + 1;\n\n      months.push({\n        label: `T${month + 1}/${String(year).slice(2)}`,\n        left: daysFromStart * pxPerDay,\n        width: monthDays * pxPerDay\n      });\n\n      curr.setMonth(curr.getMonth() + 1);\n    }\n    return months;\n  }, [timelineStart, timelineEnd, pxPerDay]);\n\n  // Lọc các item trong Gantt\n  const filteredGanttItems = useMemo(() => {\n    if (phaseFilter === 'ALL') return ganttItems;\n    if (phaseFilter === 'A') return ganttItems.filter(g => g.code.startsWith('A'));\n    if (phaseFilter === 'L') return ganttItems.filter(g => g.code.startsWith('L'));\n    if (phaseFilter === 'B') return ganttItems.filter(g => g.code.startsWith('B'));\n    if (phaseFilter === 'C') return ganttItems.filter(g => g.code.startsWith('C'));\n    return ganttItems;\n  }, [ganttItems, phaseFilter]);\n\n  // Chiều cao mỗi dòng trong bảng & biểu đồ\n  const ROW_HEIGHT = 44;\n  const HEADER_HEIGHT = 50;\n\n  // Tính tọa độ vị trí (x, width) của từng thanh Gantt\n  const taskCoordinates = useMemo(() => {\n    const coords = {};\n    filteredGanttItems.forEach((item, index) => {\n      const sDate = new Date(item.startDate);\n      const eDate = new Date(item.endDate);\n\n      const offsetDays = Math.max(0, (sDate - timelineStart) / (1000 * 60 * 60 * 24));\n      const durationDays = Math.max(1, (eDate - sDate) / (1000 * 60 * 60 * 24) + 1);\n\n      const x = offsetDays * pxPerDay;\n      const width = Math.max(14, durationDays * pxPerDay);\n      const y = HEADER_HEIGHT + index * ROW_HEIGHT + (ROW_HEIGHT - 26) / 2;\n\n      coords[item.id] = {\n        x,\n        y,\n        width,\n        height: 26,\n        endX: x + width,\n        centerY: y + 13,\n        item\n      };\n    });\n    return coords;\n  }, [filteredGanttItems, timelineStart, pxPerDay]);\n\n  // Tạo đường cong mũi tên phụ thuộc Finish-to-Start (FS)\n  const dependencyLines = useMemo(() => {\n    const lines = [];\n    filteredGanttItems.forEach((item) => {\n      if (item.dependencies && item.dependencies.length > 0) {\n        item.dependencies.forEach((depId) => {\n          const from = taskCoordinates[depId];\n          const to = taskCoordinates[item.id];\n          if (from && to) {\n            // Điểm bắt đầu: mép phải của thanh task trước (Finish)\n            const startX = from.endX;\n            const startY = from.centerY;\n            // Điểm kết thúc: mép trái của thanh task sau (Start)\n            const targetX = to.x;\n            const targetY = to.centerY;\n\n            // Đường cong Bezier hoặc Step nối từ đuôi trước sang đầu sau\n            const midX = startX + 16;\n            const pathData = `M ${startX} ${startY} L ${midX} ${startY} L ${midX} ${targetY} L ${targetX} ${targetY}`;\n\n            lines.push({\n              key: `${depId}->${item.id}`,\n              path: pathData,\n              targetX,\n              targetY\n            });\n          }\n        });\n      }\n    });\n    return lines;\n  }, [filteredGanttItems, taskCoordinates]);\n\n  // Xử lý gửi Form thêm Task\n  const handleTaskSubmit = async (e) => {\n    e.preventDefault();\n    if (!taskForm.title) return;\n    const success = await addGanttItem(taskForm);\n    if (success) {\n      setTaskForm({\n        code: '',\n        title: '',\n        isGroup: false,\n        unit: 'TK',\n        startDate: '2026-11-01',\n        endDate: '2026-11-05',\n        days: 5,\n        assignee: employees[0]?.name || 'Trần Quốc Hưng',\n        notes: '',\n        color: '#0284c7',\n        dependencies: [],\n        speed: 'on_time'\n      });\n      setShowAddTaskModal(false);\n    }\n  };\n\n  // Xử lý gửi Form thêm Project\n  const handleProjectSubmit = async (e) => {\n    e.preventDefault();\n    if (!projectForm.name) return;\n    const success = await addProject(projectForm);\n    if (success) {\n      setProjectForm({\n        name: '',\n        code: '',\n        description: '',\n        location: 'Hà Nội',\n        manager: 'Trần Quốc Hưng',\n        startDate: '2026-11-01',\n        endDate: '2027-07-02'\n      });\n      setShowAddProjectModal(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-5\">\n      \n      {/* THANH ĐIỀU KHIỂN & BỘ LỌC GANTT */}\n      <div className=\"p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm flex flex-wrap items-center justify-between gap-4\">\n        \n        {/* Chọn dự án & Banner */}\n        <div className=\"flex flex-wrap items-center gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <Building className=\"w-5 h-5 text-sky-600 flex-shrink-0\" />\n            <select\n              value={selectedProjectId}\n              onChange={(e) => setSelectedProjectId(e.target.value)}\n              className=\"py-2 px-3 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs sm:text-sm font-bold text-slate-900 dark:text-white focus:ring-2 focus:ring-sky-500 max-w-xs\"\n            >\n              {projects.map(p => (\n                <option key={p.id} value={p.id}>{p.name}</option>\n              ))}\n            </select>\n          </div>\n\n          <div className=\"hidden sm:flex items-center gap-1.5 px-3 py-1 rounded-xl bg-sky-500/10 text-sky-600 dark:text-sky-400 text-xs font-semibold\">\n            <span>Tuần T11/26 → T6/27</span>\n            <span>•</span>\n            <span>Mũi tên FS</span>\n          </div>\n        </div>\n\n        {/* Bộ lọc giai đoạn & Zoom & Nút thêm */}\n        <div className=\"flex flex-wrap items-center gap-2\">\n          \n          {/* Lọc giai đoạn */}\n          <select\n            value={phaseFilter}\n            onChange={(e) => setPhaseFilter(e.target.value)}\n            className=\"py-2 px-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-semibold text-slate-700 dark:text-slate-300\"\n          >\n            <option value=\"ALL\">Tất cả giai đoạn</option>\n            <option value=\"A\">A. Thiết Kế Xây Dựng</option>\n            <option value=\"L\">L. Nghỉ Lễ Việt Nam</option>\n            <option value=\"B\">B. Xin Phép / Pháp Lý</option>\n            <option value=\"C\">C. Mời Thầu Thi Công</option>\n          </select>\n\n          {/* Thu phóng (Zoom Level) */}\n          <div className=\"flex items-center bg-slate-100 dark:bg-slate-800 p-1 rounded-xl border border-slate-200 dark:border-slate-700\">\n            <button\n              onClick={() => setZoomLevel('month')}\n              className={`px-2 py-1 rounded-lg text-xs font-semibold ${\n                zoomLevel === 'month' ? 'bg-white dark:bg-slate-700 shadow-sm text-sky-600 dark:text-sky-400' : 'text-slate-500'\n              }`}\n            >\n              Tháng\n            </button>\n            <button\n              onClick={() => setZoomLevel('week')}\n              className={`px-2 py-1 rounded-lg text-xs font-semibold ${\n                zoomLevel === 'week' ? 'bg-white dark:bg-slate-700 shadow-sm text-sky-600 dark:text-sky-400' : 'text-slate-500'\n              }`}\n            >\n              Tuần\n            </button>\n            <button\n              onClick={() => setZoomLevel('day')}\n              className={`px-2 py-1 rounded-lg text-xs font-semibold ${\n                zoomLevel === 'day' ? 'bg-white dark:bg-slate-700 shadow-sm text-sky-600 dark:text-sky-400' : 'text-slate-500'\n              }`}\n            >\n              Chi tiết\n            </button>\n          </div>\n\n          {/* Nút Tạo Dự Án Mới */}\n          <button\n            onClick={() => setShowAddProjectModal(true)}\n            className=\"px-3 py-2 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-bold transition-all\"\n          >\n            + Dự Án Mới\n          </button>\n\n          {/* Nút Thêm Công Việc Cho Dự Án */}\n          <button\n            onClick={() => setShowAddTaskModal(true)}\n            className=\"flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold shadow-md shadow-sky-600/20 transition-all flex-shrink-0\"\n          >\n            <Plus className=\"w-3.5 h-3.5\" />\n            <span>Thêm Công Việc</span>\n          </button>\n\n        </div>\n\n      </div>\n\n      {/* CHỈ DẪN MÀU SẮC (LEGEND) */}\n      <div className=\"flex flex-wrap items-center gap-4 px-4 py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/60 text-xs\">\n        <span className=\"font-bold text-slate-400 uppercase text-[10px]\">Ghi chú màu:</span>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"w-3 h-3 rounded-full bg-sky-600 inline-block\" />\n          <span className=\"font-semibold text-slate-700 dark:text-slate-300\">A. Thiết kế</span>\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"w-3 h-3 rounded-full bg-amber-500 inline-block\" />\n          <span className=\"font-semibold text-slate-700 dark:text-slate-300\">L. Nghỉ lễ Việt Nam</span>\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"w-3 h-3 rounded-full bg-red-600 inline-block\" />\n          <span className=\"font-semibold text-slate-700 dark:text-slate-300\">B. Xin phép / Pháp lý</span>\n        </div>\n        <div className=\"flex items-center gap-1.5\">\n          <span className=\"w-3 h-3 rounded-full bg-green-600 inline-block\" />\n          <span className=\"font-semibold text-slate-700 dark:text-slate-300\">C. Mời thầu thi công</span>\n        </div>\n        <div className=\"flex items-center gap-1.5 ml-auto text-slate-500 dark:text-slate-400\">\n          <ArrowRight className=\"w-3.5 h-3.5 text-sky-500\" />\n          <span>Mũi tên liên kết Finish-to-Start (FS)</span>\n        </div>\n      </div>\n\n      {/* BẢNG TIẾN ĐỘ & BIỂU ĐỒ GANTT TƯƠNG TÁC (CỘT TRỜI ĐÓNG BĂNG) */}\n      <div className=\"rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-xl overflow-hidden\">\n        \n        {/* Banner thông báo chế độ kéo ngang & đóng băng */}\n        <div className=\"px-4 py-2 bg-slate-800 text-white text-[11px] font-semibold flex items-center justify-between\">\n          <span className=\"flex items-center gap-2\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-ping\" />\n            CỘT TRỜI ĐÓNG BĂNG : KÉO THANH CUỘN NGANG ĐỂ XEM THANH TIẾN ĐỘ BAR\n          </span>\n          <span className=\"text-slate-400 font-mono text-[10px]\">\n            {filteredGanttItems.length} hạng mục công việc\n          </span>\n        </div>\n\n        {/* Khung cuộn ngang chứa cả Bảng bên trái + Biểu đồ bên phải */}\n        <div className=\"overflow-x-auto relative max-h-[700px] overflow-y-auto\">\n          <div className=\"flex\" style={{ width: `${620 + ganttWidth}px`, minWidth: '100%' }}>\n            \n            {/* ================= KHUNG TRÁI: BẢNG DỮ LIỆU CÔNG VIỆC (ĐÓNG BĂNG FREEZE) ================= */}\n            <div className=\"w-[620px] flex-shrink-0 sticky left-0 z-30 bg-white dark:bg-slate-900 border-r-2 border-slate-300 dark:border-slate-700 shadow-lg\">\n              \n              {/* Header Bảng Bên Trái */}\n              <div\n                className=\"sticky top-0 z-40 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 flex items-center text-xs font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider\"\n                style={{ height: `${HEADER_HEIGHT}px` }}\n              >\n                <div className=\"w-12 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">STT</div>\n                <div className=\"flex-1 py-2 px-3 border-r border-slate-200 dark:border-slate-700\">CÔNG VIỆC TRONG DỰ ÁN</div>\n                <div className=\"w-14 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">ĐV</div>\n                <div className=\"w-20 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">BẮT ĐẦU</div>\n                <div className=\"w-20 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">KẾT THÚC</div>\n                <div className=\"w-14 text-center py-2 px-1 border-r border-slate-200 dark:border-slate-700\">NGÀY</div>\n                <div className=\"w-24 py-2 px-2 border-r border-slate-200 dark:border-slate-700\">GHI CHÚ</div>\n                <div className=\"w-10 text-center py-2 px-1\">XÓA</div>\n              </div>\n\n              {/* Danh Sách Các Hàng Công Việc (Tên dự án và công việc nằm bên trái) */}\n              <div className=\"divide-y divide-slate-100 dark:divide-slate-800\">\n                {filteredGanttItems.map((item) => {\n                  const isGroup = item.isGroup;\n                  const isHoliday = item.status === 'holiday';\n\n                  return (\n                    <div\n                      key={item.id}\n                      className={`flex items-center text-xs transition-colors hover:bg-slate-50 dark:hover:bg-slate-800/60 ${\n                        isGroup\n                          ? 'font-bold bg-slate-50/80 dark:bg-slate-800/80 text-slate-900 dark:text-white'\n                          : isHoliday\n                          ? 'bg-amber-500/5 text-amber-800 dark:text-amber-200'\n                          : 'text-slate-700 dark:text-slate-300'\n                      }`}\n                      style={{ height: `${ROW_HEIGHT}px` }}\n                    >\n                      {/* Cột STT */}\n                      <div className=\"w-12 text-center py-1 px-1 font-mono font-semibold border-r border-slate-100 dark:border-slate-800 truncate\">\n                        {item.code}\n                      </div>\n\n                      {/* Cột Tên Công Việc (Có thụt dòng theo cấp A -> A1 -> A1.1) */}\n                      <div\n                        className=\"flex-1 py-1 px-3 border-r border-slate-100 dark:border-slate-800 truncate flex items-center gap-1.5\"\n                        style={{\n                          paddingLeft: item.code.includes('.')\n                            ? '28px'\n                            : item.code.length > 1\n                            ? '18px'\n                            : '12px'\n                        }}\n                      >\n                        {isGroup && (\n                          <span\n                            className=\"w-2.5 h-2.5 rounded-full flex-shrink-0\"\n                            style={{ backgroundColor: item.color }}\n                          />\n                        )}\n                        <span className=\"truncate\" title={item.title}>\n                          {item.title}\n                        </span>\n                      </div>\n\n                      {/* Cột ĐV (Đơn vị thực hiện: TK, PL, CDT, NT, VN) */}\n                      <div className=\"w-14 text-center py-1 px-1 font-mono font-bold text-[11px] border-r border-slate-100 dark:border-slate-800 text-sky-600 dark:text-sky-400\">\n                        {item.unit}\n                      </div>\n\n                      {/* Cột Bắt Đầu */}\n                      <div className=\"w-20 text-center py-1 px-1 text-[11px] border-r border-slate-100 dark:border-slate-800 text-slate-500\">\n                        {item.startDate.slice(5).replace('-', '/')}\n                      </div>\n\n                      {/* Cột Kết Thúc */}\n                      <div className=\"w-20 text-center py-1 px-1 text-[11px] border-r border-slate-100 dark:border-slate-800 text-slate-500\">\n                        {item.endDate.slice(5).replace('-', '/')}\n                      </div>\n\n                      {/* Cột Ngày (Duration) */}\n                      <div className=\"w-14 text-center py-1 px-1 font-bold text-[11px] border-r border-slate-100 dark:border-slate-800\">\n                        {item.days}\n                      </div>\n\n                      {/* Cột Ghi Chú / GATE */}\n                      <div className=\"w-24 py-1 px-2 text-[10px] text-slate-400 truncate border-r border-slate-100 dark:border-slate-800\" title={item.notes}>\n                        {item.notes || '-'}\n                      </div>\n\n                      {/* Cột Xóa Công Việc */}\n                      <div className=\"w-10 text-center py-1 px-1\">\n                        <button\n                          onClick={() => deleteGanttItem(item.id)}\n                          className=\"p-1 rounded text-slate-300 hover:text-rose-500 transition-colors\"\n                          title=\"Xóa công việc này\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                        </button>\n                      </div>\n\n                    </div>\n                  );\n                })}\n              </div>\n\n            </div>\n\n            {/* ================= KHUNG PHẢI: BIỂU ĐỒ GANTT NẰM BÊN PHẢI (SVG TƯƠNG TÁC) ================= */}\n            <div className=\"relative flex-1 bg-slate-50/50 dark:bg-slate-950/50\" style={{ width: `${ganttWidth}px` }}>\n              \n              {/* Header Tháng & Tuần của Biểu Đồ Gantt */}\n              <div\n                className=\"sticky top-0 z-20 bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 flex\"\n                style={{ height: `${HEADER_HEIGHT}px`, width: `${ganttWidth}px` }}\n              >\n                {monthColumns.map((col, idx) => (\n                  <div\n                    key={idx}\n                    className=\"border-r border-slate-200 dark:border-slate-700 flex flex-col justify-center items-center px-1 text-center select-none\"\n                    style={{ width: `${col.width}px` }}\n                  >\n                    <span className=\"font-extrabold text-xs text-sky-600 dark:text-sky-400\">\n                      {col.label}\n                    </span>\n                    <span className=\"text-[10px] text-slate-400 font-mono\">\n                      Tuần 1-4\n                    </span>\n                  </div>\n                ))}\n              </div>\n\n              {/* Lưới Nền (Grid Lines) & Dải Ruy-băng Nghỉ Lễ Việt Nam */}\n              <div className=\"absolute inset-0 top-[50px] pointer-events-none flex\" style={{ width: `${ganttWidth}px` }}>\n                {monthColumns.map((col, idx) => (\n                  <div\n                    key={idx}\n                    className=\"border-r border-slate-200/40 dark:border-slate-800/40 h-full\"\n                    style={{ width: `${col.width}px` }}\n                  />\n                ))}\n              </div>\n\n              {/* KHUNG VẼ THANH GANTT & ĐƯỜNG MŨI TÊN FS BẰNG SVG CHÍNH XÁC */}\n              <svg\n                width={ganttWidth}\n                height={HEADER_HEIGHT + filteredGanttItems.length * ROW_HEIGHT + 20}\n                className=\"relative z-10\"\n              >\n                <defs>\n                  {/* Mũi tên đầu đường phụ thuộc Finish-to-Start */}\n                  <marker\n                    id=\"arrowhead\"\n                    markerWidth=\"8\"\n                    markerHeight=\"8\"\n                    refX=\"6\"\n                    refY=\"3\"\n                    orient=\"auto\"\n                  >\n                    <path d=\"M0,0 L0,6 L6,3 z\" fill=\"#0284c7\" />\n                  </marker>\n                  \n                  {/* Gradient cho các thanh bar */}\n                  <linearGradient id=\"grad-sky\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#0284c7\" />\n                    <stop offset=\"100%\" stopColor=\"#38bdf8\" />\n                  </linearGradient>\n                  <linearGradient id=\"grad-amber\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#d97706\" />\n                    <stop offset=\"100%\" stopColor=\"#fbbf24\" />\n                  </linearGradient>\n                  <linearGradient id=\"grad-red\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#b91c1c\" />\n                    <stop offset=\"100%\" stopColor=\"#ef4444\" />\n                  </linearGradient>\n                  <linearGradient id=\"grad-green\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#15803d\" />\n                    <stop offset=\"100%\" stopColor=\"#22c55e\" />\n                  </linearGradient>\n                </defs>\n\n                {/* 1. Vẽ các đường kẻ ngang phân tách từng dòng */}\n                {filteredGanttItems.map((_, idx) => (\n                  <line\n                    key={idx}\n                    x1=\"0\"\n                    y1={HEADER_HEIGHT + idx * ROW_HEIGHT}\n                    x2={ganttWidth}\n                    y2={HEADER_HEIGHT + idx * ROW_HEIGHT}\n                    stroke=\"#e2e8f0\"\n                    strokeWidth=\"1\"\n                    className=\"dark:stroke-slate-800/60\"\n                  />\n                ))}\n\n                {/* 2. HIỂN THỊ MŨI TÊN KẺ XUỐNG CÔNG VIỆC TIẾP THEO TRONG DỰ ÁN (FS Dependency) */}\n                {dependencyLines.map((line) => (\n                  <path\n                    key={line.key}\n                    d={line.path}\n                    fill=\"none\"\n                    stroke=\"#0284c7\"\n                    strokeWidth=\"1.8\"\n                    strokeDasharray=\"4 2\"\n                    markerEnd=\"url(#arrowhead)\"\n                    className=\"transition-all hover:stroke-sky-400\"\n                  />\n                ))}\n\n                {/* 3. Vẽ các thanh tiến độ Gantt Bar */}\n                {filteredGanttItems.map((item) => {\n                  const coord = taskCoordinates[item.id];\n                  if (!coord) return null;\n\n                  const isGroup = item.isGroup;\n                  const isHoliday = item.status === 'holiday';\n\n                  // Chọn màu gradient\n                  let fillColor = 'url(#grad-sky)';\n                  if (item.color === '#eab308' || isHoliday) fillColor = 'url(#grad-amber)';\n                  if (item.color === '#dc2626') fillColor = 'url(#grad-red)';\n                  if (item.color === '#16a34a') fillColor = 'url(#grad-green)';\n\n                  return (\n                    <g key={item.id} className=\"cursor-pointer group\">\n                      \n                      {/* Dải ruy băng mờ kéo ngang cho ngày lễ */}\n                      {isHoliday && (\n                        <rect\n                          x={coord.x}\n                          y={HEADER_HEIGHT}\n                          width={coord.width}\n                          height={filteredGanttItems.length * ROW_HEIGHT}\n                          fill=\"#fef08a\"\n                          fillOpacity=\"0.12\"\n                        />\n                      )}\n\n                      {/* Thanh Gantt chính */}\n                      <rect\n                        x={coord.x}\n                        y={coord.y}\n                        width={coord.width}\n                        height={coord.height}\n                        rx=\"8\"\n                        ry=\"8\"\n                        fill={fillColor}\n                        className=\"transition-all hover:opacity-90 shadow-sm\"\n                        filter=\"drop-shadow(0 2px 4px rgba(0,0,0,0.12))\"\n                      />\n\n                      {/* Nhãn trên thanh hoặc cạnh thanh: Tên người đảm nhận, thời gian, tăng ca */}\n                      <text\n                        x={coord.endX + 8}\n                        y={coord.centerY + 4}\n                        fill=\"#64748b\"\n                        fontSize=\"11\"\n                        fontWeight=\"600\"\n                        className=\"dark:fill-slate-300 select-none pointer-events-none\"\n                      >\n                        {item.assignee} ({item.days} ngày)\n                        {item.overtimeHours && (\n                          <tspan fill=\"#f59e0b\" fontWeight=\"bold\"> [+{item.overtimeHours}h OT]</tspan>\n                        )}\n                        {item.speed === 'early' && (\n                          <tspan fill=\"#10b981\"> [Sớm]</tspan>\n                        )}\n                        {item.speed === 'delayed' && (\n                          <tspan fill=\"#ef4444\" fontWeight=\"bold\"> [Chậm]</tspan>\n                        )}\n                      </text>\n\n                      {/* Chữ hiển thị bên trong thanh nếu đủ rộng */}\n                      {coord.width > 60 && (\n                        <text\n                          x={coord.x + 8}\n                          y={coord.centerY + 4}\n                          fill=\"#ffffff\"\n                          fontSize=\"10\"\n                          fontWeight=\"bold\"\n                          className=\"select-none pointer-events-none truncate\"\n                        >\n                          {item.code} {coord.width > 120 ? `- ${item.days}d` : ''}\n                        </text>\n                      )}\n\n                    </g>\n                  );\n                })}\n\n              </svg>\n\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n\n      {/* MODAL 1: THÊM CÔNG VIỆC VÀO DỰ ÁN */}\n      {showAddTaskModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in\">\n          <div className=\"w-full max-w-xl p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n                <CalendarRange className=\"w-5 h-5 text-sky-600\" />\n                Thêm Công Việc Mới Vào Tiến Độ Dự Án\n              </h3>\n              <button\n                onClick={() => setShowAddTaskModal(false)}\n                className=\"text-slate-400 hover:text-white font-bold\"\n              >\n                ✕\n              </button>\n            </div>\n\n            <form onSubmit={handleTaskSubmit} className=\"space-y-3.5\">\n              \n              <div className=\"grid grid-cols-3 gap-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Mã STT (VD: A1.3, B6)\n                  </label>\n                  <input\n                    type=\"text\"\n                    required\n                    placeholder=\"A1.3\"\n                    value={taskForm.code}\n                    onChange={(e) => setTaskForm({ ...taskForm, code: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Đơn Vị (ĐV)\n                  </label>\n                  <select\n                    value={taskForm.unit}\n                    onChange={(e) => setTaskForm({ ...taskForm, unit: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold text-sky-600\"\n                  >\n                    <option value=\"TK\">TK (Thiết kế)</option>\n                    <option value=\"CDT\">CDT (Chủ đầu tư)</option>\n                    <option value=\"PL\">PL (Pháp lý)</option>\n                    <option value=\"NT\">NT (Nhà thầu)</option>\n                    <option value=\"VN\">VN (Lễ Việt Nam)</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Màu Sắc\n                  </label>\n                  <select\n                    value={taskForm.color}\n                    onChange={(e) => setTaskForm({ ...taskForm, color: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  >\n                    <option value=\"#0284c7\">Xanh dương (Thiết kế)</option>\n                    <option value=\"#eab308\">Vàng (Nghỉ lễ)</option>\n                    <option value=\"#dc2626\">Đỏ (Pháp lý)</option>\n                    <option value=\"#16a34a\">Xanh lá (Đấu thầu)</option>\n                  </select>\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                  Tên Công Việc *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"VD: Kiểm tra tính toán tải trọng kết cấu móng\"\n                  value={taskForm.title}\n                  onChange={(e) => setTaskForm({ ...taskForm, title: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Người Đảm Nhận\n                  </label>\n                  <select\n                    value={taskForm.assignee}\n                    onChange={(e) => setTaskForm({ ...taskForm, assignee: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  >\n                    {employees.map(e => (\n                      <option key={e.id} value={e.name}>{e.name} ({e.title})</option>\n                    ))}\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Công Việc Trước (Mũi tên liên kết FS)\n                  </label>\n                  <select\n                    onChange={(e) => {\n                      const val = e.target.value;\n                      setTaskForm({ ...taskForm, dependencies: val ? [val] : [] });\n                    }}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  >\n                    <option value=\"\">-- Không có liên kết FS --</option>\n                    {ganttItems.map(g => (\n                      <option key={g.id} value={g.id}>[{g.code}] {g.title}</option>\n                    ))}\n                  </select>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-3 gap-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Ngày Bắt Đầu\n                  </label>\n                  <input\n                    type=\"date\"\n                    required\n                    value={taskForm.startDate}\n                    onChange={(e) => setTaskForm({ ...taskForm, startDate: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Ngày Kết Thúc\n                  </label>\n                  <input\n                    type=\"date\"\n                    required\n                    value={taskForm.endDate}\n                    onChange={(e) => setTaskForm({ ...taskForm, endDate: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Số Ngày (d)\n                  </label>\n                  <input\n                    type=\"number\"\n                    min=\"1\"\n                    value={taskForm.days}\n                    onChange={(e) => setTaskForm({ ...taskForm, days: Number(e.target.value) })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-bold\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                  Ghi Chú / GATE Kiểm Soát\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"VD: GATE 1B: CĐT phê duyệt tối đa 3 ngày\"\n                  value={taskForm.notes}\n                  onChange={(e) => setTaskForm({ ...taskForm, notes: e.target.value })}\n                  className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                />\n              </div>\n\n              <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-200 dark:border-slate-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddTaskModal(false)}\n                  className=\"px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800\"\n                >\n                  Hủy\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-md shadow-sky-600/20\"\n                >\n                  Lưu Vào Tiến Độ Gantt\n                </button>\n              </div>\n\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* MODAL 2: TẠO DỰ ÁN MỚI */}\n      {showAddProjectModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-fade-in\">\n          <div className=\"w-full max-w-lg p-6 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-2xl space-y-4\">\n            <div className=\"flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3\">\n              <h3 className=\"text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2\">\n                <Building className=\"w-5 h-5 text-sky-600\" />\n                Khởi Tạo Dự Án Xây Dựng Mới (APS)\n              </h3>\n              <button\n                onClick={() => setShowAddProjectModal(false)}\n                className=\"text-slate-400 hover:text-white font-bold\"\n              >\n                ✕\n              </button>\n            </div>\n\n            <form onSubmit={handleProjectSubmit} className=\"space-y-3.5\">\n              <div>\n                <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                  Tên Dự Án Xây Dựng *\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  placeholder=\"VD: DỰ ÁN XÂY DỰNG TRUNG TÂM CÔNG NGHỆ APS HÀ NỘI\"\n                  value={projectForm.name}\n                  onChange={(e) => setProjectForm({ ...projectForm, name: e.target.value })}\n                  className=\"w-full px-3.5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-semibold\"\n                />\n              </div>\n\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Mã Dự Án\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"APS-2026-03\"\n                    value={projectForm.code}\n                    onChange={(e) => setProjectForm({ ...projectForm, code: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs font-mono\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"text-xs font-semibold text-slate-700 dark:text-slate-300 block mb-1\">\n                    Địa Điểm\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"Hòa Lạc, Hà Nội\"\n                    value={projectForm.location}\n                    onChange={(e) => setProjectForm({ ...projectForm, location: e.target.value })}\n                    className=\"w-full px-3 py-2 rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-xs\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"flex items-center justify-end gap-3 pt-3 border-t border-slate-200 dark:border-slate-800\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowAddProjectModal(false)}\n                  className=\"px-4 py-2 rounded-xl text-xs font-bold text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800\"\n                >\n                  Hủy\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"px-5 py-2 rounded-xl bg-sky-600 hover:bg-sky-500 text-white font-bold text-xs shadow-md shadow-sky-600/20\"\n                >\n                  Tạo Dự Án\n                </button>\n              </div>\n\n            </form>\n          </div>\n        </div>\n      )}\n\n    </div>\n  );\n}\n","Description":"Create Gantt chart and project progress module mimicking real construction schedule","Overwrite":true,"TargetFile":"C:\\Users\\GiaWyy\\.gemini\\antigravity\\scratch\\aps-project-manager\\frontend\\src\\modules\\gantt\\GanttPage.jsx","toolAction":"Creating GanttPage component","toolSummary":"Create GanttPage.jsx"}}]}
