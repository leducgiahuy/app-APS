ects.find(p => p.id === projectId);\n49:     if (proj) projName = proj.name;\n50:   }\n51: \n52:   const days = Number(estimatedDays) || 1;\n53:   const hours = days * 8; // 8 tiếng / ngày chuẩn\n54: \n55:   const newTask = {\n56:     id: `task-${Date.now()}`,\n57:     projectId: projectId || 'proj-1',\n58:     projectName: projName || 'DỰ ÁN XÂY DỰNG TRUNG TÂM CÔNG NGHỆ APS VIỆT NAM',\n59:     phase: phase || 'A. THIẾT KẾ XÂY DỰNG',\n60:     title,\n61:     employeeId,\n62:     employeeName,\n63:     startDate: startDate || new Date().toISOString().split('T')[0],\n64:     endDate: endDate || new Date().toISOString().split('T')[0],\n65:     estimatedHours: hours,\n66:     estimatedDays: days,\n67:     status: 'in_progress',\n68:     speedStatus: 'on_time', // 'early', 'on_time', 'delayed'\n69:     priority: priority || 'normal', // 'normal', 'high', 'urgent'\n70:     progress: 0,\n71:     notes: notes || ''\n72:   };\n73: \n74:   db.tasks.push(newTask);\n75: \n76:   // Đồng thời thêm vào Gantt Chart nếu cần\n77:   const newGanttItem = {\n78:     id: `G-${Date.now()}`,\n79:     code: `T${db.tasks.length}`,\n80:     title,\n81:     isGroup: false,\n82:     color: '#0284c7',\n83:     unit: 'APS',\n84:     startDate: newTask.startDate,\n85:     endDate: newTask.endDate,\n86:     days: newTask.estimatedDays,\n87:     assignee: employeeName,\n88:     notes: notes || '',\n89:     status: 'in_progress',\n90:     speed: 'on_time',\n91:     progress: 0,\n92:     dependencies: []\n93:   };\n94:   db.ganttItems.push(newGanttItem);\n95: \n96:   writeDb(db);\n97: \n98:   return res.status(201).json({\n99:     success: true,\n100:     message: 'Phân công nhiệm vụ thành công',\n101:     data: newTask\n102:   });\n103: }\n104: \n105: // Cập nhật trạng thái nhiệm vụ (Hoàn thành, Đang làm, Nhanh/Chậm)\n106: export function updateTask(req, res) {\n107:   const db = readDb();\n108:   const { id } = req.params;\n109:   const { status, progress, speedStatus, notes } = req.body;\n110: \n11