 = {\n305:       id: `task-${Date.now()}`,\n306:       ganttId: newItem.id,\n307:       projectId: 'proj-1',\n308:       projectName: 'DỰ ÁN XÂY DỰNG TRUNG TÂM CÔNG NGHỆ APS VIỆT NAM',\n309:       phase: phaseName,\n310:       title: newItem.title,\n311:       code: newItem.code,\n312:       employeeId: emp ? emp.id : 'emp-1',\n313:       employeeName: emp ? emp.name : newItem.assignee,\n314:       startDate: newItem.startDate,\n315:       endDate: newItem.endDate,\n316:       estimatedHours: newItem.days * 8,\n317:       estimatedDays: newItem.days,\n318:       status: 'in_progress',\n319:       speedStatus: newItem.speed || 'on_time',\n320:       priority: 'high',\n321:       progress: 0,\n322:       notes: newItem.notes || ''\n323:     };\n324: \n325:     // Đẩy vào db.tasks\n326:     if (!db.tasks) db.tasks = [];\n327:     db.tasks.push(matchedTask);\n328:   }\n329: \n330:   writeDb(db);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
