anttItems[i].code, formattedCode) < 0) {\n252:         insertIdx = i;\n253:       }\n254:     }\n255:   }\n256: \n257:   // === 2. TỰ ĐỘNG TẠO ĐƯỜNG MŨI TÊN LIÊN KẾT FS NỐI XUỐNG ===\n258:   let autoDependencies = Array.isArray(dependencies) ? [...dependencies] : [];\n259:   if (autoDependencies.length === 0 && !isGroup) {\n260:     // Tự động liên kết tới công việc đứng ngay trước đó để vẽ đường nối xuống\n261:     if (insertIdx >= 0 && db.ganttItems[insertIdx]) {\n262:       autoDependencies.push(db.ganttItems[insertIdx].id);\n263:     }\n264:   }\n265: \n266:   const newItem = {\n267:     id: newGanttId,\n268:     code: formattedCode,\n269:     title,\n270:     isGroup: Boolean(isGroup),\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
