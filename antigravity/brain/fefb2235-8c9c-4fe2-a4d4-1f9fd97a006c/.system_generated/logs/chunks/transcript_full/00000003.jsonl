s.length);\n  for (let i = 0; i < len; i++) {\n    const sa = pa.segments[i];\n    const sb = pb.segments[i];\n    if (sa === undefined) return -1;\n    if (sb === undefined) return 1;\n    if (typeof sa === 'number' && typeof sb === 'number') {\n      if (sa !== sb) return sa - sb;\n    } else {\n      const cmp = String(sa).localeCompare(String(sb));\n      if (cmp !== 0) return cmp;\n    }\n  }\n  return 0;\n}\n\nconst list = [\n  { code: 'A' },\n  { code: 'A1' },\n  { code: 'A1.1' },\n  { code: 'A1.2' },\n  { code: 'A2' },\n  { code: 'A2.1' },\n  { code: 'L' },\n  { code: 'B' },\n  { code: 'C' }\n];\n\nfunction insertWbs(arr, newItem) {\n  let insertIdx = -1;\n  for (let i = 0; i < arr.length; i++) {\n    if (compareWbs(arr[i].code, newItem.code) < 0) {\n      insertIdx = i;\n    }\n  }\n  arr.splice(insertIdx + 1, 0, newItem);\n}\n\ninsertWbs(list, { code: 'A1.3' });\nconsole.log(list.map(x => x.code).join(', '));\n\"","Cwd":"C:\\Users\\GiaWyy\\.gemini\\antigravity\\scratch\\aps-project-manager","WaitMsBeforeAsync":5000,"toolAction":"Testing insertWbs logic","toolSummary":"Test insertWbs function"}}]}
