gments };\n38: }\n39: \n40: /**\n41:  * So sánh 2 mã WBS để sắp xếp đúng thứ tự câ\n<truncated 5549 bytes>\n     const emp = db.employees.find(e => e.name.trim().toLowerCase() === empNameNorm) || db.employees[0];\n205: \n206:     // Xác định tên giai đoạn (Phase)\n207:     let phaseName = 'A. THIẾT KẾ XÂY DỰNG';\n208:     const upperCode = newItem.code.toUpperCase();\n209:     if (upperCode.startsWith('B')) phaseName = 'B. XIN PHÉP / PHÁP LÝ';\n210:     else if (upperCode.startsWith('C')) phaseName = 'C. MỜI THẦU THI CÔNG';\n211: