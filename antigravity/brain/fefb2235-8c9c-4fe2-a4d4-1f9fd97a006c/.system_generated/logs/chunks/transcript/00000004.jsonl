n278: // Xóa công việc khỏi biểu đồ Gantt (đồng bộ xóa trong db.tasks)\n279: export function deleteGanttItem(req, res) {\n280:   const db = readDb();\n281:   const { id } = req.params;\n282: \n283:   const index = db.ganttItems.findIndex(g => g.id === id);\n284:   if (index === -1) {\n285:     return res.status(404).json({ success: false, message: 'Không tìm thấy công việc' });\n286:   }\n287: \n288:   const removed = db.ganttItems.splice(index, 1);\n289: \n290:   // Đồng bộ xóa trong db.tasks\n291:   if (db.tasks) {\n292:     db.tasks = db.tasks.filter(t => t.ganttId !== id && t.title !== removed[0].title);\n293:   }\n294: \n295:   writeDb(db);\n296: \n297:   return res.json({\n298:     success: true,\n299:     message: `Đã xóa công việc \"${removed[0].title}\" khỏi tiến độ và đồng bộ nhiệm vụ`,\n300:     data: removed[0]\n301:   });\n302: }\n303: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}
